# /etc/cron.d/sociafy
#
# Sociafy scheduled jobs. Install with:
#
#   sudo install -m 0644 etc/cron.d/sociafy /etc/cron.d/sociafy
#   sudo systemctl restart cron     # or  cron reload
#
# Adjust SOCIAFY_DIR + the user account if your deploy differs. Stdout/stderr
# go to /var/log/sociafy/cron-<task>.log so a failing run is grep-able without
# wading through cron's default mail behaviour.
#
# Schedule (UTC by default — crond inherits the system tz; set TZ= here if
# you want a different reference for these jobs specifically):
#   publish              every 5 min  — picks up due scheduled_posts
#   finalize-video-jobs  every 5 min  — reaps stuck video/image jobs, refunds them
#   shield-monitor       every 15 min — Reputation Shield scan for opted-in users
#   refresh-tokens       every 6 h    — refreshes OAuth tokens before expiry
#   trends               hourly       — pulls fresh trend rows per niche
#   agent                every 2 h    — autopilot drafting + auto-publish
#   reissue-invoices     hourly       — re-raises GST invoices Zoho rejected
#
# finalize-video-jobs is not optional: a stuck job holds the customer's credits
# until this sweeps it. Nothing else ever refunds them. Same for
# reissue-invoices: a customer who paid and never got a tax invoice is a
# compliance problem, and the payment webhook only ever tries once.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

SOCIAFY_DIR=/opt/sociafy-app
NODE_BIN=/usr/bin/node
LOG_DIR=/var/log/sociafy

# The user column is NOT variable-expanded by cron, so it is spelled out.
# flock -n: skip a tick if the previous run of the same job is still going.
# timeout: kill a hung run. publish MUST stay under 15m — runPublish marks
# rows stuck in 'publishing' longer than that as publish_timeout_unknown.
#
# m    h   dom mon dow user     command
*/5    *   *   *   *   sociafy  cd $SOCIAFY_DIR && flock -n /tmp/sociafy-publish.lock timeout -k 30s 10m $NODE_BIN --import tsx scripts/cron-run.mjs publish             >> $LOG_DIR/cron-publish.log             2>&1
*/5    *   *   *   *   sociafy  cd $SOCIAFY_DIR && flock -n /tmp/sociafy-finalize-video-jobs.lock timeout -k 30s 10m $NODE_BIN --import tsx scripts/cron-run.mjs finalize-video-jobs >> $LOG_DIR/cron-finalize-video-jobs.log 2>&1
*/15   *   *   *   *   sociafy  cd $SOCIAFY_DIR && flock -n /tmp/sociafy-shield-monitor.lock timeout -k 30s 14m $NODE_BIN --import tsx scripts/cron-run.mjs shield-monitor      >> $LOG_DIR/cron-shield-monitor.log      2>&1
0      */6 *   *   *   sociafy  cd $SOCIAFY_DIR && flock -n /tmp/sociafy-refresh-tokens.lock timeout -k 30s 30m $NODE_BIN --import tsx scripts/cron-run.mjs refresh-tokens      >> $LOG_DIR/cron-refresh-tokens.log      2>&1
0      *   *   *   *   sociafy  cd $SOCIAFY_DIR && flock -n /tmp/sociafy-trends.lock timeout -k 30s 50m $NODE_BIN --import tsx scripts/cron-run.mjs trends              >> $LOG_DIR/cron-trends.log              2>&1
0      */2 *   *   *   sociafy  cd $SOCIAFY_DIR && flock -n /tmp/sociafy-agent.lock timeout -k 30s 110m $NODE_BIN --import tsx scripts/cron-run.mjs agent               >> $LOG_DIR/cron-agent.log               2>&1
30     *   *   *   *   sociafy  cd $SOCIAFY_DIR && flock -n /tmp/sociafy-reissue-invoices.lock timeout -k 30s 50m $NODE_BIN --import tsx scripts/cron-run.mjs reissue-invoices    >> $LOG_DIR/cron-reissue-invoices.log    2>&1
