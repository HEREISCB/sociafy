# =============================================================
# Sociafy — environment configuration
# =============================================================
# Copy this file to .env.local and fill values.
# In stub mode (no keys), the app runs end-to-end with fake data.
# Each section flips to real behavior once its keys are present.

# ----- App -----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random 32+ char strings.
INTERNAL_API_SECRET=dev-secret-change-me
CRON_SECRET=dev-cron-secret-change-me

# ----- Clerk (auth) -----
# Dashboard → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional path overrides — defaults are /sign-in and /sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/onboarding

# ----- Postgres (any provider — Supabase pooler URL / Neon / etc.) -----
DATABASE_URL=

# ----- Anthropic (compose + agent) -----
ANTHROPIC_API_KEY=

# ----- OpenAI (AI crisis-response drafting + AI web-search handle resolution) -----
# Required for the Reputation Shield's AI features. web_search is OpenAI-hosted,
# so this specifically needs OpenAI (Groq has no hosted web search). Without it,
# script drafting falls back to templates and handle resolution falls back to
# X user-search. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional cheaper fallback for script drafting only (no web search). https://console.groq.com/keys
GROQ_API_KEY=

# ----- Cloudflare R2 (media storage) -----
# Cloudflare dashboard → R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL for served objects — either the bucket's public r2.dev URL or your custom domain.
# Example: https://pub-<hash>.r2.dev   or   https://media.sociafy.app
NEXT_PUBLIC_R2_PUBLIC_URL_BASE=

# ----- Modal GPU engines (Voice Twin + Avatar) -----
# Deploy modal/voice_engine.py and modal/avatar_engine.py, then paste the
# web-endpoint base URLs here. Absent → stub mode (fake assets, app still runs).
MODAL_VOICE_ENGINE_URL=
MODAL_AVATAR_ENGINE_URL=
# Shared secret; must match the Modal Secret `sociafy-engine` ENGINE_SECRET value.
MODAL_WEBHOOK_SECRET=

# ----- Reputation Shield: X/Twitter READS -----
# TwitterAPI.io — pay-as-you-go X search used to fetch brand mentions without an
# official X API subscription. https://twitterapi.io  (auth: X-API-Key header)
TWITTERAPI_IO_KEY=

# ----- Stripe (USD billing) -----
# Dashboard → Developers → API keys. Absent → USD checkout returns 503 and the
# billing page steers the user to INR/Razorpay instead.
STRIPE_SECRET_KEY=
# Webhook signing secret for the /api/stripe/webhook endpoint (Developers →
# Webhooks → your endpoint → Signing secret). Credits are granted there, not
# at checkout time, so without this nobody gets what they paid for.
STRIPE_WEBHOOK_SECRET=
# Recurring monthly Price IDs (price_...), one per tier — Product catalogue →
# your product → Pricing. Must be USD/month and match the amounts in
# lib/billing/pricing.ts ($30 / $80 / $299). All three are required: a missing
# one makes the whole USD path report "not configured".
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
# Credit top-ups need no Price ID — the $15 / 1,000-credit pack is created
# inline from TOPUP_PRICING at session time.

# ----- OAuth / posting credentials -----
# X (Twitter) — https://developer.x.com  (OAuth 2.0 + offline.access)
# Used by the shield to POST replies on the user's behalf (Free tier is enough).
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn — https://developer.linkedin.com  (OIDC + w_member_social)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Meta (covers Instagram + Facebook) — https://developers.facebook.com
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business — Configuration ID created in the dashboard.
# When set, OAuth uses this configuration's permissions instead of requesting scopes inline.
META_CONFIG_ID=

# TikTok — https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Google (covers YouTube) — https://console.cloud.google.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
